# Solver Configuration
# Copy this file to .env and fill in your values

# Solver identifier (alphanumeric, 5-15 characters)
SOLVER_ID=mysolver001

# Auctioneer WebSocket URL
AUCTIONEER_WS_URL=ws://localhost:8080/auction

# Ethereum private key (without 0x prefix)
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key_here

# Solana private key (base58 encoded)
SOLANA_PRIVATE_KEY=your_solana_private_key_base58_here

# Commission in basis points (100 = 1%)
COMMISSION_BPS=100