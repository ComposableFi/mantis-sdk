  "devDependencies": {
    "@typechain/ethers-v6": "^0.5.1",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.50.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
